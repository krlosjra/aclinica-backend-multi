# Banco de dados PostgreSQL — host/usuário/senha compartilhados entre
# o banco mestre e o banco de cada clínica (só o nome do banco muda).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# Banco mestre: guarda o registro de quais clínicas existem, o domínio
# de email de cada uma e o nome do banco de dados dela. Ver
# sql/master_schema.sql.
MASTER_DB_NAME=clinicas_web

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000

# Origem(ns) do frontend em produção, separadas por vírgula
# (ex: https://app.suaclinica.com.br). Sem isso, CORS libera só
# localhost:5173 — nunca deixe essa variável vazia em produção.
FRONTEND_URL=
